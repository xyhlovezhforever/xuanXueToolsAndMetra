      "css": ".ds-btn-secondary{min-height:40px;padding:8px 12px;border:1px solid var(--line,#d9e4dc);border-radius:8px;background:var(--surface-muted,#edf3ef);color:var(--text,#172923);font:600 14px/20px Manrope,system-ui,sans-serif;cursor:pointer;transition:border-color 180ms ease,color 180ms ease}.ds-btn-secondary:hover{border-color:var(--jade,#236e57);color:var(--jade,#236e57)}.ds-btn-secondary:focus-visible{outline:3px solid var(--jade,#236e57);outline-offset:2px}.ds-btn-secondary:active{transform:scale(.98)}"
    },
    {
      "name": "珊瑚行动按钮",
      "kind": "button",
      "refersTo": "button-coral",
      "description": "玄览图解中执行起卦等直接行动。",
      "html": "<button class='ds-btn-coral'>数字起卦</button>",
      "css": ".ds-btn-coral{min-height:44px;padding:10px 18px;border:1px solid var(--red,#c94c3b);border-radius:4px;background:var(--red,#c94c3b);color:var(--surface,#fff);font:700 14px/20px Manrope,system-ui,sans-serif;cursor:pointer}.ds-btn-coral:hover{background:#9e352a}.ds-btn-coral:focus-visible{outline:2px solid var(--text,#172923);outline-offset:2px}.ds-btn-coral:active{transform:scale(.98)}"
    },
    {
      "name": "资料输入框",
      "kind": "input",
      "refersTo": "field",
      "description": "工具参数与检索中的标准输入框。",
      "html": "<label class='ds-field'><span>检索资料</span><input type='search' placeholder='输入关键词'></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--muted,#586a60);font:600 12px/16px Manrope,system-ui,sans-serif}.ds-field input{width:280px;max-width:100%;height:40px;padding:8px 12px;border:1px solid var(--line,#d9e4dc);border-radius:4px;background:var(--surface-muted,#edf3ef);color:var(--text,#172923);font:400 14px/20px Manrope,system-ui,sans-serif}.ds-field input:focus-visible{outline:3px solid var(--jade,#236e57);outline-offset:2px}"
    },
    {
      "name": "玉绿状态标签",
      "kind": "chip",
      "refersTo": "tag",
      "description": "可用、来源和已确认资料状态。",
      "html": "<span class='ds-tag'>来源可核查</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;min-height:24px;padding:4px 8px;border-radius:4px;background:var(--jade-soft,#e4f3ea);color:var(--jade,#236e57);font:600 12px/16px Manrope,system-ui,sans-serif}"
    },
    {
      "name": "资料侧栏项",
      "kind": "nav",
      "description": "桌面资料门类中的当前导航项。",
      "html": "<button class='ds-nav-item ds-active'><span>资料库</span><small>检索与阅读</small></button>",
      "css": ".ds-nav-item{width:220px;min-height:56px;display:grid;gap:2px;padding:8px 12px;border:0;border-radius:8px;background:transparent;color:var(--text,#172923);text-align:left;cursor:pointer}.ds-nav-item span{font:600 14px/20px Manrope,system-ui,sans-serif}.ds-nav-item small{color:var(--muted,#586a60);font:400 12px/16px Manrope,system-ui,sans-serif}.ds-nav-item:hover{background:var(--surface,#fff)}.ds-nav-item.ds-active{background:var(--surface,#fff);color:var(--jade,#236e57);box-shadow:0 2px 12px rgba(23,41,35,.05)}.ds-nav-item:focus-visible{outline:3px solid var(--jade,#236e57);outline-offset:2px}"
    },
    {
      "name": "参考索引条目",
      "kind": "card",
      "description": "资料库中横向扫描的索引行。",
      "html": "<article class='ds-reference-row'><span class='ds-reference-meta'>术数资料 · 入门</span><strong>六爻基础</strong><p>按来源、口径与示例查阅完整条目。</p><span class='ds-reference-tag'>有来源</span></article>",
      "css": ".ds-reference-row{width:420px;max-width:100%;min-height:116px;padding:20px 12px;border-top:1px solid var(--line,#d9e4dc);border-bottom:1px solid var(--line,#d9e4dc);background:transparent;color:var(--text,#172923);font-family:Manrope,system-ui,sans-serif;transition:background 180ms ease}.ds-reference-row:hover{background:var(--surface,#fff)}.ds-reference-meta{display:block;margin-bottom:8px;color:var(--jade,#236e57);font-size:12px;line-height:16px;font-weight:700}.ds-reference-row strong{font-size:18px;line-height:26px}.ds-reference-row p{margin:6px 0 12px;color:var(--muted,#586a60);font-size:14px;line-height:20px}.ds-reference-tag{padding:4px 8px;border-radius:4px;background:var(--jade-soft,#e4f3ea);color:var(--jade,#236e57);font-size:12px;line-height:16px}"
    },
    {
      "name": "分段选择",
      "kind": "nav",
      "description": "资料形式与工作模式的紧凑切换。",
      "html": "<div class='ds-segment'><button class='ds-selected'>资料</button><button>图解</button><button>工具</button></div>",
      "css": ".ds-segment{display:inline-flex;gap:4px;padding:4px;border-radius:8px;background:var(--surface-muted,#edf3ef)}.ds-segment button{min-height:32px;padding:4px 12px;border:0;border-radius:4px;background:transparent;color:var(--muted,#586a60);font:600 14px/20px Manrope,system-ui,sans-serif;cursor:pointer}.ds-segment button:hover{color:var(--text,#172923)}.ds-segment button.ds-selected{background:var(--surface,#fff);color:var(--text,#172923);box-shadow:0 2px 8px rgba(32,37,31,.08)}.ds-segment button:focus-visible{outline:3px solid var(--jade,#236e57);outline-offset:2px}"
    },
    {
      "name": "独立工具面板",
      "kind": "card",
      "refersTo": "panel",
      "description": "表单与结果的单一操作边界。",
      "html": "<section class='ds-panel'><h3>计算结果</h3><p>盘面事实与规则口径在此展示。</p></section>",
      "css": ".ds-panel{width:320px;max-width:100%;padding:24px;border:1px solid var(--line,#d9e4dc);border-radius:8px;background:var(--surface,#fff);color:var(--text,#172923);font-family:Manrope,system-ui,sans-serif}.ds-panel h3{margin:0 0 8px;font:700 18px/28px DengXian,'Microsoft YaHei',sans-serif}.ds-panel p{margin:0;color:var(--muted,#586a60);font-size:14px;line-height:20px}"
    }
  ],
  "narrative": {
    "northStar": "可检索的知识地图",
    "overview": "界面像一本可操作的田野索引：深森林色导航建立坐标，浅色纸面承载资料、计算结果与日常记录。品牌存在于字体、颜色和有节制的状态变化中；高频操作和品牌印象同等重要。\n\n内容层级依靠标题、编号、分隔线和留白建立。参考目录采用紧凑横向条目，工具与需要操作边界的资料才使用明确的框面。暗色主题通过同名 CSS 变量切换，而非另起一套结构。",
    "keyCharacteristics": [
      "深色导航和浅色内容形成稳定的工作台框架。",
      "大标题有中文衬线气质，功能文字清晰紧凑。",
      "红与绿承担不同状态，内容区保持克制。",
      "目录优先扫描效率，图解保留可交互的空间感。"
    ],
    "rules": [
      {
        "name": "The State Color Rule",
        "body": "红色强调行动与当前项；绿色标示资料和状态。两者只在有意义的功能位置出现。",
        "section": "colors"
      },
      {
        "name": "The Two-Voice Rule",
        "body": "衬线只承担页面级中文标题；导航、检索、控件和数据保持无衬线。",
        "section": "typography"
      },
      {
        "name": "The Index First Rule",
        "body": "高频资料列表先保证标题、来源、标签和入口可扫描，再使用框面强调需要独立操作的对象。",
        "section": "layout"
      },
      {
        "name": "The Flat Reading Rule",
        "body": "阅读与检索区域以色块、分隔线和留白建立深度；阴影用来提示选中或悬停，不承担正文结构。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 让资料入口保留来源、分类、标题与标签的快速扫描顺序。",
      "Do 在需要独立操作的工具、书目和数据面板上使用明确框面。",
      "Do 同时验证浅色与暗色变量下的文字、边框和状态对比。",
      "Do 保留鼠标、键盘与移动端都可辨认的交互状态，并尊重减少动态效果的系统设置。"
    ],
    "donts": [
      "Don't 把普通资料索引改成密集浮动卡片，削弱横向阅读顺序。",
      "Don't 让红、绿、金同时争夺同一控件的主状态。",
      "Don't 用大面积阴影或装饰色替代目录、标题和分隔线的内容层级。"
    ]
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小渐知你",
  "version": "0.1.1",
  "identifier": "com.xiaojianzhini.studio",
  "build": {
    "beforeDevCommand": "npm run desktop:dev-server",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../desktop-server/": "server/",
      "../dist/": "dist/"
    }
  }
}
